# ZenodoPipeline — environment template
#
# Copy this file to `.env` and fill in real values before running.
# Never commit your .env (it is gitignored).

# Zenodo SANDBOX personal access token (https://sandbox.zenodo.org/account/settings/applications/)
ZENODO_SANDBOX_TOKEN=

# Zenodo personal access token (https://zenodo.org/account/settings/applications/)
ZENODO_TOKEN=
